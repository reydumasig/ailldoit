# Production Environment Variables for app.ailldoit.com
# Add these to Replit Secrets when deploying to production

# Environment
NODE_ENV=production

# Firebase Configuration (Production)
VITE_FIREBASE_API_KEY=your_production_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_production_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_production_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_production_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_production_messaging_sender_id
VITE_FIREBASE_APP_ID=your_production_firebase_app_id
FIREBASE_SERVICE_ACCOUNT_KEY=your_production_firebase_service_account_key

# Database (Production)
DATABASE_URL=your_production_database_url

# Stripe LIVE Keys (Production)
STRIPE_LIVE_SECRET_KEY=sk_live_your_live_secret_key
VITE_STRIPE_LIVE_PUBLIC_KEY=pk_live_your_live_public_key
VITE_STRIPE_LIVE_STARTER_PRICE_ID=price_live_starter_price_id
VITE_STRIPE_LIVE_GROWTH_PRICE_ID=price_live_growth_price_id
STRIPE_LIVE_WEBHOOK_SECRET=whsec_live_webhook_secret

# AI Services (Production)
OPENAI_API_KEY=your_production_openai_key
GEMINI_API_KEY=your_production_gemini_key
REPLICATE_API_TOKEN=your_production_replicate_token

# Domain Configuration
REPLIT_DOMAINS=app.ailldoit.com

# Observability — Sentry (error tracking, production project)
SENTRY_DSN=your_server_sentry_dsn
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=your_client_sentry_dsn
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Set by CI to the git sha at build time so errors pin to a deploy.
SENTRY_RELEASE=
VITE_SENTRY_RELEASE=

# Observability — PostHog (product analytics, production project)
POSTHOG_API_KEY=your_posthog_server_api_key
POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_KEY=your_posthog_public_project_api_key
VITE_POSTHOG_HOST=https://us.i.posthog.com